                "lessons": [
                    {
                        "id": 151,
                        "section_id": 1,
                        "name": "قواسم عدد طبيعي",
                        "summary": "قاسم عدد طبيعي $a$ هو كل عدد طبيعي $b$ حيث يكون باقي قسمة $a$ على $b$ معدوماً. قواسم العدد المشتركة تساعدنا في تبسيط الكسور.",
                        "example_problem": "أوجد مجموعة قواسم العدد $36$",
                        "example_steps": [
                            "نبحث عن كل جداء لعددين طبيعيين يعطي $36$:",
                            "$$36 = 1 \\times 36$$",
                            "$$36 = 2 \\times 18$$",
                            "$$36 = 3 \\times 12$$",
                            "$$36 = 4 \\times 9$$",
                            "$$36 = 6 \\times 6$$",
                            {
                                "text": "$$36 = {\\color{red}9} \\times 4$$",
                                "type": "stop"
                            },
                            {
                                "text": "- العدد $1$ قاسم لكل عدد طبيعي $a$ لأن $a = 1 \\times a$.\\n- كل عدد طبيعي $a$ غير معدوم يقبل القسمة على نفسه لأن $a = a \\times 1$.",
                                "type": "notes"
                            },
                            "مجموعة قواسم العدد $36$ هي: $\\{1, 2, 3, 4, 6, 9, 12, 18, 36\\}$"
                        ],
                        "application_problem": "أوجد قواسم العدد $24$",
                        "application_solution": "$\\{1, 2, 3, 4, 6, 8, 12, 24\\}$",
                        "order": 1,
                        "is_locked": false,
                        "created_at": "2026-03-28T17:41:21.000000Z",
                        "updated_at": "2026-04-02T20:58:10.000000Z",
                        "lab_type": "divisor_discovery",
                        "lab_config": null,
                        "access_type": "classic",
                        "price": 0,
                        "application_hint": "تذكر أن قواسم العدد هي الأعداد التي تقسمه تماماً بدون باقٍ. ابدأ بالرقم 1 والعدد نفسه."
                    },
                    {
                        "id": 152,
                        "section_id": 1,
                        "name": "خواص قواسم عدد طبيعي",
                        "summary": "نتعلم في هذا الدرس أهم خواص القواسم المتعلقة بالعمليات الحسابية (الجمع والطرح) وباقي القسمة الإقليدية.",
                        "example_problem": "اكتشف خواص القواسم عبر التجارب التفاعلية:",
                        "example_steps": [
                            {
                                "text": "حوصلة:",
                                "type": "notes"
                            },
                            "$a$ و $b$ و $n$ أعداد طبيعية غير معدومة و $a > b$.",
                            {
                                "text": "خاصية 1:",
                                "type": "notes"
                            },
                            "إذا كان $n$ يقسم كلاً من $a$ و $b$، فإن $n$ يقسم كلاً من $(a+b)$ و $(a-b)$.",
                            "مثال: لدينا $5$ يقسم كلاً من $15$ و $35$ إذن: $5$ يقسم كلاً من $50 (15+35)$ و $20 (35-15)$.",
                            {
                                "text": "خاصية 2:",
                                "type": "notes"
                            },
                            "إذا كان $n$ يقسم كلاً من $a$ و $b$، و $r$ باقي قسمة $a$ على $b$، فإن $n$ يقسم $r$.",
                            "مثال: لدينا $7$ يقسم كلاً من $56$ و $21$.\\nباقي قسمة $56$ على $21$ هو $14$.\\nإذن: $7$ يقسم $14$."
                        ],
                        "application_problem": "هل $6$ يقسم مجموع $12$ و $18$؟ علل.",
                        "application_solution": "نعم، لأن $6$ يقسم كلاً من $12$ ($12=6 \\times 2$) و $18$ ($18=6 \\times 3$).",
                        "order": 2,
                        "is_locked": false,
                        "created_at": "2026-03-28T17:41:21.000000Z",
                        "updated_at": "2026-03-29T19:20:57.000000Z",
                        "lab_type": "divisor_properties",
                        "lab_config": null,
                        "access_type": "classic",
                        "price": 0,
                        "application_hint": "استخدم الخاصية: إذا كان n يقسم a و b، فإنه يقسم مجموعمهما."
                    },
                    {
                        "id": 153,
                        "section_id": 1,
                        "name": "القاسم المشترك الأكبر (PGCD)",
                        "summary": "القاسم المشترك الأكبر لعددين هو أكبر عدد يقسمهما معاً. نستخدمه لاختزال الكسور وتبسيط الحسابات.",
                        "example_problem": "أوجد $PGCD(12, 18)$",
                        "example_steps": [
                            "نكتب قواسم العدد $12$: $\\{1, 2, 3, 4, 6, 12\\}$",
                            "نكتب قواسم العدد $18$: $\\{1, 2, 3, 6, 9, 18\\}$",
                            "القواسم المشتركة هي: $\\{1, 2, 3, 6\\}$",
                            "أكبر قاسم مشترك هو $6$."
                        ],
                        "application_problem": "احسب $PGCD(24, 36)$",
                        "application_solution": "$12$",
                        "order": 3,
                        "is_locked": false,
                        "created_at": "2026-03-28T17:41:21.000000Z",
                        "updated_at": "2026-03-29T19:20:57.000000Z",
                        "lab_type": "pgcd_all",
                        "lab_config": null,
                        "access_type": "classic",
                        "price": 0,
                        "application_hint": "يمكنك استخدام خوارزمية إقليدس (القسمات المتتالية) لإيجاد القاسم المشترك الأكبر بسرعة."
                    },
                    {
                        "id": 154,
                        "section_id": 1,
                        "name": "العددان الأوليان فيما بينهما",
                        "summary": "نقول عن عددين طبيعيين أنهما أوليان فيما بينهما إذا كان قاسمهما المشترك الأكبر يساوي 1.",
                        "example_problem": "هل العددان 15 و 8 أوليان فيما بينهما؟",
                        "example_steps": [
                            "نحسب $PGCD(15, 8)$ باستخدام خوارزمية إقليدس:",
                            "$$15 = 8 \\times 1 + 7$$",
                            "$$8 = 7 \\times 1 + 1$$",
                            "$$7 = 1 \\times 7 + 0$$",
                            "بما أن آخر باق غير معدوم هو 1، فإن $PGCD(15, 8) = 1$."
                        ],
                        "application_problem": "هل 21 و 14 أوليان فيما بينهما؟",
                        "application_solution": "لا",
                        "order": 4,
                        "is_locked": false,
                        "created_at": "2026-03-28T17:41:21.000000Z",
                        "updated_at": "2026-03-29T19:20:57.000000Z",
                        "lab_type": "coprime_lab",
                        "lab_config": null,
                        "access_type": "classic",
                        "price": 0,
                        "application_hint": "تكون الأعداد أولية فيما بينها إذا كان PGCD لهما يساوي 1. ابحث عن قاسم مشترك أكبر من 1."
                    },
                    {
